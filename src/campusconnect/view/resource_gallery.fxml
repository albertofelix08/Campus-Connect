<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="campusconnect.controller.ResourceGalleryController">

    <!-- Main gallery content -->
    <VBox styleClass="page" spacing="12">
        <VBox spacing="2">
            <Label text="Resource Gallery" styleClass="page-title" />
            <Label text="Drag a resource card onto an activity in the list below to assign it."
                   styleClass="page-subtitle" />
        </VBox>

        <!-- Resource cards in a FlowPane inside a ScrollPane -->
        <ScrollPane fitToWidth="true" prefHeight="270" minHeight="150">
            <FlowPane fx:id="resourceFlowPane" hgap="14" vgap="14" styleClass="flow-pad" />
        </ScrollPane>

        <Label text="Drop target — select an activity, then drag a card onto the list" styleClass="section-title" />

        <!-- Activity drop target list -->
        <ListView fx:id="dropTargetList" styleClass="activity-list" prefHeight="200" VBox.vgrow="ALWAYS" />
    </VBox>

    <!-- Conflict warning overlay (hidden until a conflict is detected) -->
    <StackPane fx:id="conflictOverlay" styleClass="overlay-scrim" visible="false">
        <VBox styleClass="modal-card" maxWidth="420" maxHeight="-Infinity">
            <Label fx:id="conflictTitleLabel" text="⚠  Scheduling Conflict Detected"
                   styleClass="modal-title-danger" wrapText="true" />
            <Label fx:id="conflictDetailLabel"
                   text="This resource is already booked for that date and time slot."
                   wrapText="true" />
            <Label text="Pick a different resource, or adjust the activity's date / time slot."
                   wrapText="true" styleClass="hint" />
            <HBox spacing="10">
                <Button text="OK, go back" onAction="#handleConflictCancel" styleClass="btn-danger" />
            </HBox>
        </VBox>
    </StackPane>

</StackPane>
