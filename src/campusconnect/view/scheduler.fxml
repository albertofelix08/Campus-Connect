<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="campusconnect.controller.SchedulerController"
      styleClass="page" spacing="14">

    <VBox spacing="2">
        <Label text="Activity Scheduler" styleClass="page-title" />
        <Label text="A five-day view of every venue, colour-coded by status" styleClass="page-subtitle" />
    </VBox>

    <!-- Filter bar -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Venue" styleClass="field-label" />
        <ComboBox fx:id="venueFilterCombo" onAction="#handleVenueFilter" prefWidth="220" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="◀ Prev"  onAction="#handlePrev" />
        <Button text="Today"   onAction="#handleToday" />
        <Button text="Next ▶"  onAction="#handleNext" />
        <Label fx:id="rangeLabel" styleClass="section-title" />
    </HBox>

    <!-- Calendar grid — built dynamically in the controller -->
    <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS">
        <GridPane fx:id="calendarGrid" hgap="4" vgap="4" />
    </ScrollPane>

    <Label text="Tip: double-click a free cell (+) to create an activity there. Double-click a booked cell to view its details."
           styleClass="hint" />

</VBox>
