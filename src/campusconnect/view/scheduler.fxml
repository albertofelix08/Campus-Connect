<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="campusconnect.controller.SchedulerController"
      spacing="10" style="-fx-padding: 15;">

    <Label text="Activity Scheduler" style="-fx-font-size: 18; -fx-font-weight: bold;" />

    <!-- Filter bar -->
    <HBox spacing="10" style="-fx-alignment: center-left;">
        <Label text="Filter by Venue:" />
        <ComboBox fx:id="venueFilterCombo" onAction="#handleVenueFilter" prefWidth="220" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="◀ Prev"  onAction="#handlePrev" />
        <Button text="Today"   onAction="#handleToday" />
        <Button text="Next ▶"  onAction="#handleNext" />
        <Label fx:id="rangeLabel" style="-fx-font-weight: bold;" />
    </HBox>

    <!-- Calendar grid — built dynamically in the controller -->
    <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS">
        <GridPane fx:id="calendarGrid" hgap="2" vgap="2" style="-fx-padding: 5;" />
    </ScrollPane>

    <Label text="Tip: Double-click a free cell (+) to create an activity there.  Double-click a booked cell to view its details."
           style="-fx-text-fill: gray; -fx-font-style: italic;" />

</VBox>
