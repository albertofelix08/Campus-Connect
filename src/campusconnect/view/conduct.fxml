<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="campusconnect.controller.ConductController"
      styleClass="page" spacing="16">

    <!-- Declared explicitly (rather than only referenced via "$statusGroup") so
         FXMLLoader actually injects it into the controller's @FXML statusGroup field. -->
    <fx:define>
        <ToggleGroup fx:id="statusGroup" />
    </fx:define>

    <VBox spacing="2">
        <Label text="Activity Detail" styleClass="page-title" />
        <Label text="Move the activity through its lifecycle and record how it went" styleClass="page-subtitle" />
    </VBox>

    <!-- Status segmented control -->
    <VBox spacing="8">
        <Label text="Status" styleClass="field-label" />
        <HBox spacing="0">
            <ToggleButton fx:id="proposedBtn"  text="Proposed"  toggleGroup="$statusGroup" styleClass="segment, segment-first, s-proposed" />
            <ToggleButton fx:id="approvedBtn"  text="Approved"  toggleGroup="$statusGroup" styleClass="segment, s-approved" />
            <ToggleButton fx:id="ongoingBtn"   text="Ongoing"   toggleGroup="$statusGroup" styleClass="segment, s-ongoing" />
            <ToggleButton fx:id="completedBtn" text="Completed" toggleGroup="$statusGroup" styleClass="segment, s-completed" />
            <ToggleButton fx:id="cancelledBtn" text="Cancelled" toggleGroup="$statusGroup" styleClass="segment, segment-last, s-cancelled" />
        </HBox>
    </VBox>

    <!-- Detail card -->
    <VBox styleClass="card">
        <GridPane hgap="20" vgap="12">
            <columnConstraints>
                <ColumnConstraints minWidth="170" prefWidth="170" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <Label text="Title"        styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Label fx:id="titleLabel"  styleClass="value-strong" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Category"     styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Label fx:id="categoryLabel" styleClass="value-label" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Venue"        styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Label fx:id="venueLabel"  styleClass="value-label" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Date"         styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <Label fx:id="dateLabel"   styleClass="value-label" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label text="Coordinator"  styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <Label fx:id="coordinatorLabel" styleClass="value-label" GridPane.columnIndex="1" GridPane.rowIndex="4" />

            <Label text="Expected"     styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="5" />
            <Label fx:id="expectedLabel" styleClass="value-label" GridPane.columnIndex="1" GridPane.rowIndex="5" />

            <Label text="Actual attendance" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="6" />
            <TextField fx:id="actualAttendanceField" GridPane.columnIndex="1" GridPane.rowIndex="6" prefWidth="120" maxWidth="120" />

            <Label text="Closing remarks" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="7" />
            <TextArea fx:id="remarksArea" GridPane.columnIndex="1" GridPane.rowIndex="7"
                      prefWidth="420" maxWidth="520" prefHeight="90" wrapText="true" />
        </GridPane>
    </VBox>

    <Label fx:id="errorLabel" text="" styleClass="error-text" wrapText="true" />

    <HBox spacing="10">
        <Button text="Save Changes" onAction="#handleSaveChanges" styleClass="btn-primary" />
        <Button text="Back"         onAction="#handleBack" />
    </HBox>

</VBox>
