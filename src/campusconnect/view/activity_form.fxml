<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!-- ScrollPane root so the long form stays reachable on small windows. -->
<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="campusconnect.controller.ActivityFormController"
            fitToWidth="true" styleClass="page-scroll">
    <content>
        <VBox styleClass="page" spacing="16">

            <!-- Declared explicitly (rather than only referenced via "$categoryGroup") so
                 FXMLLoader actually injects it into the controller's @FXML categoryGroup field. -->
            <fx:define>
                <ToggleGroup fx:id="categoryGroup" />
            </fx:define>

            <VBox spacing="2">
                <Label fx:id="formTitleLabel" text="New Activity" styleClass="page-title" />
                <Label text="Fill in the details, then save to add it to the schedule" styleClass="page-subtitle" />
            </VBox>

            <!-- Main form card -->
            <VBox styleClass="card">
                <GridPane hgap="20" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints minWidth="170" prefWidth="170" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>

                    <Label text="Title"            styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="titleField"  GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="420" maxWidth="520" />

                    <Label text="Description"      styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextArea fx:id="descriptionArea" GridPane.columnIndex="1" GridPane.rowIndex="1"
                              prefWidth="420" maxWidth="520" prefHeight="80" wrapText="true" />

                    <Label text="Category"         styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <FlowPane hgap="18" vgap="6"   GridPane.columnIndex="1" GridPane.rowIndex="2" prefWrapLength="760">
                        <RadioButton fx:id="academicRadio"        text="Academic"         toggleGroup="$categoryGroup" />
                        <RadioButton fx:id="cocurricularRadio"    text="Co-curricular"    toggleGroup="$categoryGroup" />
                        <RadioButton fx:id="extracurricularRadio" text="Extra-curricular" toggleGroup="$categoryGroup" />
                        <RadioButton fx:id="nonAcademicRadio"     text="Non-academic"     toggleGroup="$categoryGroup" />
                        <RadioButton fx:id="otherRadio"           text="Other"            toggleGroup="$categoryGroup" />
                    </FlowPane>

                    <Label text="Date"             styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <DatePicker fx:id="datePicker" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <Label text="Time slot"        styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <ComboBox fx:id="timeSlotCombo" GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="220" />

                    <Label text="Venue"            styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                    <ComboBox fx:id="venueCombo"   GridPane.columnIndex="1" GridPane.rowIndex="5" prefWidth="220" />

                    <Label text="Coordinator"      styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                    <ComboBox fx:id="coordinatorCombo" GridPane.columnIndex="1" GridPane.rowIndex="6" prefWidth="220" />

                    <Label text="Expected participants" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                    <TextField fx:id="participantsField" GridPane.columnIndex="1" GridPane.rowIndex="7" prefWidth="120" maxWidth="120" />

                    <!-- Facilities as CheckBoxes in a FlowPane -->
                    <Label text="Facilities"       styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="8" />
                    <FlowPane hgap="18" vgap="6"   GridPane.columnIndex="1" GridPane.rowIndex="8" prefWrapLength="760">
                        <CheckBox fx:id="projectorCheck"    text="Projector" />
                        <CheckBox fx:id="micCheck"          text="Mic Set" />
                        <CheckBox fx:id="wifiCheck"         text="Wi-Fi" />
                        <CheckBox fx:id="cateringCheck"     text="Catering" />
                        <CheckBox fx:id="photographyCheck"  text="Photography" />
                    </FlowPane>
                </GridPane>
            </VBox>

            <!-- Error label -->
            <Label fx:id="errorLabel" text="" styleClass="error-text" wrapText="true" />

            <!-- Action buttons -->
            <HBox spacing="10">
                <Button text="Save"   onAction="#handleSave"   styleClass="btn-primary" />
                <Button text="Cancel" onAction="#handleCancel" />
            </HBox>

        </VBox>
    </content>
</ScrollPane>
