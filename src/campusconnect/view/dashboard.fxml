<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="campusconnect.controller.DashboardController"
      spacing="10" style="-fx-padding: 15;">

    <!-- Toolbar row -->
    <HBox spacing="10">
        <TextField fx:id="searchField" promptText="Search activities..." prefWidth="300" HBox.hgrow="SOMETIMES" />
        <Button text="+ New Activity" onAction="#handleNewActivity" />
        <Button text="Cancel Selected" onAction="#handleCancelActivity" />
    </HBox>

    <!-- ListView scrolls by itself; wrapping it in a ScrollPane gave a fixed-height list with nested scrollbars -->
    <ListView fx:id="activityListView" VBox.vgrow="ALWAYS" />

</VBox>
