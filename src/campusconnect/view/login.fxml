<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!-- Gradient backdrop with a centred card. All colours/spacing live in theme.css. -->
<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="campusconnect.controller.LoginController"
           styleClass="login-bg"
           prefWidth="900" prefHeight="600">

    <VBox fx:id="loginCard" styleClass="login-card"
          prefWidth="400" maxWidth="400" maxHeight="-Infinity">

        <Label text="CC" styleClass="brand-mark" />
        <Label text="CampusConnect" styleClass="login-title" />
        <Label text="Activity planning, scheduling and execution" styleClass="login-subtitle" />

        <Label text="Username" styleClass="field-label">
            <VBox.margin><javafx.geometry.Insets top="18" /></VBox.margin>
        </Label>
        <TextField fx:id="usernameField" promptText="Enter username" />

        <Label text="Password" styleClass="field-label">
            <VBox.margin><javafx.geometry.Insets top="8" /></VBox.margin>
        </Label>
        <PasswordField fx:id="passwordField" promptText="Enter password" />

        <!-- Error message (empty until login fails) -->
        <Label fx:id="errorLabel" text="" styleClass="error-text" wrapText="true" minHeight="20" />

        <HBox spacing="10">
            <Button text="Sign in" onAction="#handleLogin" defaultButton="true"
                    styleClass="btn-primary" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
            <Button text="Clear" onAction="#handleClear" />
        </HBox>

        <!-- AI disclosure -->
        <HBox styleClass="login-footer">
            <Label text="AI" styleClass="ai-badge" />
            <Label text="Polished with AI assistance" styleClass="hint" />
        </HBox>
    </VBox>

</StackPane>
