<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="campusconnect.controller.ReportsController"
      styleClass="page" spacing="16">

    <VBox spacing="2">
        <Label text="Reports" styleClass="page-title" />
        <Label text="Calendar, resource utilisation and participation at a glance" styleClass="page-subtitle" />
    </VBox>

    <!-- Report type selector -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Report type" styleClass="field-label" />
        <ChoiceBox fx:id="reportTypeChoice" prefWidth="240" />
    </HBox>

    <!-- Summary strip -->
    <HBox fx:id="summaryStrip" spacing="12">
        <Label fx:id="summaryLabel1" text="Total: 0"     styleClass="stat-chip" />
        <Label fx:id="summaryLabel2" text="Approved: 0"  styleClass="stat-chip" />
        <Label fx:id="summaryLabel3" text="Completed: 0" styleClass="stat-chip" />
    </HBox>

    <!-- Report results -->
    <ListView fx:id="reportListView" styleClass="report-list" VBox.vgrow="ALWAYS" />

</VBox>
