<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!-- BorderPane is the whole app shell after login. Its centre is filled by Navigator
     (dashboard.fxml first, then whichever screen the user opens). -->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:id="mainShell"
            fx:controller="campusconnect.controller.ShellController"
            prefWidth="1100" prefHeight="680">

    <!-- TOP: MenuBar -->
    <top>
        <MenuBar>
            <Menu text="File">
                <MenuItem text="New Activity"   onAction="#handleNewActivity" />
                <SeparatorMenuItem />
                <MenuItem text="Exit"           onAction="#handleExit" />
            </Menu>
            <Menu text="Activity">
                <MenuItem text="New Activity"   onAction="#handleNewActivity" />
                <MenuItem text="Approve"        onAction="#handleApproveActivity" />
                <MenuItem text="Cancel Activity" onAction="#handleCancelActivity" />
            </Menu>
            <Menu text="Resources">
                <MenuItem text="View Gallery"   onAction="#handleOpenResources" />
                <MenuItem text="Add Resource"   onAction="#handleAddResource" />
            </Menu>
            <Menu text="Reports">
                <MenuItem text="Open Reports"   onAction="#handleOpenReports" />
            </Menu>
            <Menu text="Help">
                <MenuItem text="About"          onAction="#handleAbout" />
            </Menu>
        </MenuBar>
    </top>

    <!-- LEFT: navigation sidebar -->
    <left>
        <VBox styleClass="sidebar" prefWidth="232" minWidth="232">

            <HBox styleClass="brand-row" spacing="10" alignment="CENTER_LEFT">
                <Label text="CC" styleClass="brand-mark-sm" />
                <VBox>
                    <Label text="CampusConnect" styleClass="brand-name" />
                    <Label text="Polished Edition" styleClass="brand-sub" />
                </VBox>
            </HBox>

            <Label text="MENU" styleClass="nav-section" />
            <Button fx:id="navDashboard"   text="Dashboard"    onAction="#handleNavDashboard"  styleClass="nav-button" maxWidth="Infinity" />
            <Button fx:id="navNewActivity" text="New Activity" onAction="#handleNewActivity"   styleClass="nav-button" maxWidth="Infinity" />
            <Button fx:id="navResources"   text="Resources"    onAction="#handleOpenResources" styleClass="nav-button" maxWidth="Infinity" />
            <Button fx:id="navScheduler"   text="Scheduler"    onAction="#handleOpenScheduler" styleClass="nav-button" maxWidth="Infinity" />
            <Button fx:id="navReports"     text="Reports"      onAction="#handleOpenReports"   styleClass="nav-button" maxWidth="Infinity" />

            <Region VBox.vgrow="ALWAYS" />

            <HBox styleClass="user-block" alignment="CENTER_LEFT">
                <StackPane styleClass="avatar">
                    <Label fx:id="avatarLabel" text="?" />
                </StackPane>
                <VBox>
                    <Label fx:id="userNameLabel" text="user" styleClass="user-name" />
                    <Label fx:id="userRoleLabel" text="role" styleClass="user-role" />
                </VBox>
            </HBox>

            <!-- AI disclosure -->
            <HBox styleClass="ai-note">
                <Label text="AI" styleClass="ai-badge" />
                <Label text="Polished with AI assistance" styleClass="ai-note-text" wrapText="true" />
            </HBox>
        </VBox>
    </left>

    <!-- BOTTOM: status bar -->
    <bottom>
        <HBox styleClass="status-bar">
            <Label fx:id="statusBarLabel" text="Welcome to CampusConnect" />
        </HBox>
    </bottom>

</BorderPane>
