<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!-- BorderPane is the whole app shell after login. Its centre is filled by Navigator
     (dashboard.fxml first, then whichever screen the user opens). -->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:id="mainShell"
            fx:controller="campusconnect.controller.ShellController"
            prefWidth="1100" prefHeight="680">

    <!-- TOP: MenuBar -->
    <top>
        <MenuBar>
            <Menu text="File">
                <MenuItem text="New Activity"   onAction="#handleNewActivity" />
                <SeparatorMenuItem />
                <MenuItem text="Exit"           onAction="#handleExit" />
            </Menu>
            <Menu text="Activity">
                <MenuItem text="New Activity"   onAction="#handleNewActivity" />
                <MenuItem text="Approve"        onAction="#handleApproveActivity" />
                <MenuItem text="Cancel Activity" onAction="#handleCancelActivity" />
            </Menu>
            <Menu text="Resources">
                <MenuItem text="View Gallery"   onAction="#handleOpenResources" />
                <MenuItem text="Add Resource"   onAction="#handleAddResource" />
            </Menu>
            <Menu text="Reports">
                <MenuItem text="Open Reports"   onAction="#handleOpenReports" />
            </Menu>
            <Menu text="Help">
                <MenuItem text="About"          onAction="#handleAbout" />
            </Menu>
        </MenuBar>
    </top>

    <!-- LEFT: Navigation sidebar (VBox of buttons) -->
    <left>
        <VBox spacing="5" style="-fx-background-color: #34495E; -fx-padding: 10;" prefWidth="160">
            <Button text="Dashboard"    onAction="#handleNavDashboard"  maxWidth="Infinity" />
            <Button text="New Activity" onAction="#handleNewActivity"   maxWidth="Infinity" />
            <Button text="Resources"    onAction="#handleOpenResources" maxWidth="Infinity" />
            <Button text="Scheduler"    onAction="#handleOpenScheduler" maxWidth="Infinity" />
            <Button text="Reports"      onAction="#handleOpenReports"   maxWidth="Infinity" />
        </VBox>
    </left>

    <!-- BOTTOM: Status bar -->
    <bottom>
        <HBox style="-fx-background-color: #BDC3C7; -fx-padding: 5 10;">
            <Label fx:id="statusBarLabel" text="Welcome to CampusConnect" />
        </HBox>
    </bottom>

</BorderPane>
