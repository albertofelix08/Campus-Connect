diff --git a/src/campusconnect/view/activity_form.fxml b/src/campusconnect/view/activity_form.fxml
index 10942d1..8161dde 100644
--- a/src/campusconnect/view/activity_form.fxml
+++ b/src/campusconnect/view/activity_form.fxml
@@ -7,6 +7,12 @@
